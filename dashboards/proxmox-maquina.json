    {
      "id": 6,
      "type": "gauge",
      "title": "Disco usado (real)",
      "datasource": {
        "type": "prometheus",
        "uid": "pmx-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "max": 100,
          "min": 0,
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "minVizHeight": 60,
        "minVizWidth": 60,
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "sizing": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pmx-prometheus"
          },
          "editorMode": "code",
          "expr": "(100 * sum by (id) (pve_guest_fs_used_bytes{nodo=\"$nodo\",name=\"$maquina\"}) / sum by (id) (pve_guest_fs_size_bytes{nodo=\"$nodo\",name=\"$maquina\"})) or (100 * sum by (id) (pve_disk_usage_bytes{id=~\"lxc/.*\",instance=\"$nodo\"} * on(id) group_left() pve_guest_info{instance=\"$nodo\",name=\"$maquina\"}) / sum by (id) (pve_disk_size_bytes{id=~\"lxc/.*\",instance=\"$nodo\"} * on(id) group_left() pve_guest_info{instance=\"$nodo\",name=\"$maquina\"}))",
          "refId": "A",
          "range": true
        }
      ],
      "description": "Uso real de DENTRO. En una VM lo contesta su qemu-guest-agent; en un LXC lo sabe el nodo. Vacio = la maquina esta apagada o su agente no contesta (p. ej. RouterOS/CHR, que no tiene agente)."
    },
